<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="8.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.grptwo.schedulerapp.controllers.Controller"
      stylesheets="@../css/welcome.css"
      styleClass="root">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Label text="Welcome G2!" styleClass="subheader"/>
    <Label text="It's Time to" styleClass="header"/>
    <Label text="Organize Your Day!" styleClass="header">
        <VBox.margin>
            <Insets bottom="25.0"/>
        </VBox.margin>
    </Label>

    <Button fx:id="continueBtn" text="Continue" onAction="#onContinueButtonClick"
            styleClass="primary-button" prefWidth="240" prefHeight="50"/>

</VBox>